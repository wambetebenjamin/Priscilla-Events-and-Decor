# ---------------------------------------------------------------------------
# Priscilla Events and Decor. Every secret lives here and nowhere else.
# Copy to .env.local for local development, and set the same names in the
# Vercel project settings for production. Nothing secret is ever committed.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Used for canonical URLs, Open Graph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://priscillaeventsanddecor.co.ke

# --- reCAPTCHA v3 (invisible) ----------------------------------------------
# The site key is public by design and is exposed to the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server side only. Never exposed to the browser.
RECAPTCHA_SECRET_KEY=
# v2 fallback keys, used only when a v3 score lands below the threshold.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
# Score below which the v2 challenge is required. The brief sets this at 0.5.
RECAPTCHA_SCORE_THRESHOLD=0.5
# Expected hostname on the verification response.
RECAPTCHA_EXPECTED_HOSTNAME=

# --- Vercel KV (enquiries, bridal bookings, subscribers) -------------------
# Injected automatically by the Vercel KV integration. When these are absent the
# app falls back to an in-process store so local previews and CI builds still work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Vercel Blob (portfolio photos if self-hosted) -------------------------
BLOB_READ_WRITE_TOKEN=

# --- Email (Nodemailer) ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Priscilla Events and Decor <hello@priscillaeventsanddecor.co.ke>"
# Where enquiries, bridal bookings and contact messages are delivered.
EVENTS_TEAM_EMAIL=events@priscillaeventsanddecor.co.ke
BRIDAL_TEAM_EMAIL=bridal@priscillaeventsanddecor.co.ke
# Optional reply-to override.
SMTP_REPLY_TO=

# --- WhatsApp --------------------------------------------------------------
# Public enquiry number, digits only, in international format.
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
# WhatsApp Cloud API, used to notify the events team and to send the client
# their reference number. When absent, the app records the wa.me deep link
# instead so no enquiry is ever lost.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEAM_NUMBER=254112272061
WHATSAPP_TEMPLATE_ENQUIRY=priscilla_enquiry_alert
WHATSAPP_TEMPLATE_CONFIRMATION=priscilla_reference_confirmation

# --- Google Maps -----------------------------------------------------------
# Not required: the studio map uses the keyless embed. Set only if you move to
# the Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
